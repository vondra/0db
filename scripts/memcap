#!/usr/bin/env bash
# memcap — run a heavy builder inside a bounded-memory cgroup, so a runaway allocation
# OOM-kills only ITSELF (the job fails and re-queues) instead of triggering a GLOBAL
# OOM that takes the whole box down with any interactive session on it.
#
# Why this exists: the kernel log shows a GUARDED build dying as CONSTRAINT_MEMCG
# (contained — the box survives) while an UNGUARDED one triggered a global_oom that
# killed Claude+tmux on he84. This wrapper is the single chokepoint every heavy
# builder is launched through, so the guard can't be forgotten on one path.
#
# Mechanism (auto-detected per host — no config):
#   • user systemd reachable (he84, ry177) → run in a transient --scope with
#     MemoryMax = RAM − reserve − /dev/shm-in-use, MemorySwapMax=0 (no swap thrash);
#     the kernel OOM-kills only this scope's cgroup, nothing else.
#   • no user systemd (vast containers)    → the container's own cgroup limit already
#     contains a runaway and we can't carve a child cgroup (not delegated), so we just
#     mark this process the OOM-killer's first pick and run it directly. If there is ALSO
#     no container limit (bare metal, no systemd), the build is genuinely uncapped — we
#     warn loudly rather than pretend it's safe.
#
# Ramdisk-aware: /dev/shm (tmpfs = RAM) holds the cluster's staged data, so the cap
# subtracts its current size — a build can never claim RAM the ramdisk already needs.
# The cap is NEVER raised above that (RAM−reserve−shm) value; on a box too small for it
# the build fails inside its scope (contained), which beats a global OOM.
#
# Usage:  scripts/memcap <cmd> [args...]        env: MEMCAP_RESERVE_GB=20
set -euo pipefail
[ "$#" -ge 1 ] || { echo "memcap: usage: memcap <cmd> [args...]" >&2; exit 2; }

total_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
# `|| true` so a df failure (missing /dev/shm, restricted container) can't abort under set -e.
shm_kb=$(df -k --output=used /dev/shm 2>/dev/null | tail -1 | tr -dc '0-9' || true); shm_kb=${shm_kb:-0}
cap_kb=$(( total_kb - ${MEMCAP_RESERVE_GB:-20} * 1024 * 1024 - shm_kb ))
# When /dev/shm (the cluster's OWN staged data, transient) is large enough that RAM−reserve−shm can't
# fit a build, the RESERVE is what's starving it — the box still has RAM−shm free, which IS enough.
# Shrink to a 2 GiB reserve so the build RUNS (still CONTAINED at RAM−2−shm; the kernel OOM-kills only
# this cgroup, never global). he84/localhost reads data/ directly so shm≈0 → its cap stays large, it
# never hits this, and the interactive session stays fully protected. A squeezed worker box is fine
# (contained + requeues); the OLD behaviour clamped to 1 GiB, which just GUARANTEED an OOM-kill of every
# build whenever a worker's ramdisk transiently filled (the world-build prefetch staged 2 dense chunks).
if [ "$cap_kb" -lt "$(( ${MEMCAP_FLOOR_GB:-24} * 1024 * 1024 ))" ]; then
  cap_kb=$(( total_kb - 2 * 1024 * 1024 - shm_kb ))
fi
# Last resort: shm has genuinely filled the box (no room even at a 2 GiB reserve). A 1 GiB cap would
# only guarantee the OOM-kill, so run UNCAPPED + first OOM pick instead (fails contained-ish, requeues).
if [ "$cap_kb" -lt 1048576 ]; then
  echo "memcap: WARNING — /dev/shm $(( shm_kb / 1024 / 1024 ))G fills $(hostname) (only $(( cap_kb / 1024 ))M free); running UNCAPPED (oom_score_adj)" >&2
  echo 800 > /proc/self/oom_score_adj 2>/dev/null || true
  exec "$@"
fi

# A probe scope (same props as the real launch) detects a usable user systemd manager.
if systemd-run --user --scope -q -p MemoryMax=64M -p MemorySwapMax=0 true 2>/dev/null; then
  exec systemd-run --user --scope -q -p MemoryMax="${cap_kb}K" -p MemorySwapMax=0 -- "$@"
fi
# No user systemd → safe only if a container cgroup already bounds us (vast sets memory.max).
if [ "$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)" = max ]; then
  echo "memcap: WARNING — no user systemd and no container memory cap on $(hostname): build is UNCAPPED" >&2
fi
echo 800 > /proc/self/oom_score_adj 2>/dev/null || true   # be the OOM victim, not the worker
exec "$@"
