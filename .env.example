# Change this for every additional checkout; 8520 is the primary default.
PORT=8520
HOST=127.0.0.1

# DATA_YEAR normally comes from the committed pin scripts/dataset-year.json.
# Override it only when intentionally serving a different prepared-data year.
# DATA_YEAR=2026

# Full paths to shared generated data. Defaults are data/prepared/<year>/h3r4
# and data/tiles/<year>/pmtiles when these are omitted.
# H3R4_DIR=/srv/0db/prepared/2026/h3r4
# PMTILES_DIR=/srv/0db/tiles/2026/pmtiles

# Development instances should not be indexed. Cluster routes remain loopback-gated in Fastify
# and basic-authenticated by Caddy; dev checkouts expose them so their dashboard edits are testable.
ROBOTS_NOINDEX=1
ENABLE_CLUSTER_ROUTES=1

# Optional cache used by the aircraft route.
# AIRCRAFT_CACHE_DIR=/srv/0db/aircraft-cache
